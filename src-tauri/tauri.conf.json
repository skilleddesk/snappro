{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapPro",
  "version": "0.1.1",
  "identifier": "com.snappro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SnapPro",
        "width": 372,
        "height": 668,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "visible": true,
        "center": false,
        "x": 80,
        "y": 80
      },
      {
        "label": "region",
        "title": "SnapPro Region",
        "url": "index.html",
        "width": 900,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "editor",
        "title": "SnapPro Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "center": true
      },
      {
        "label": "recorder",
        "title": "SnapPro Recorder",
        "width": 580,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "preview",
        "title": "SnapPro Preview",
        "width": 480,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Screenshot, annotate and record your screen",
    "longDescription": "SnapPro is a modern screenshot, annotation and screen recording suite with AI tools, OCR and cloud sharing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "SnapPro",
    "copyright": "Copyright (c) SnapPro",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "SnapPro"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [],
        "recommends": [
          "ffmpeg",
          "tesseract-ocr",
          "xdotool",
          "gstreamer1.0-tools",
          "gstreamer1.0-pipewire",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      },
      "rpm": {
        "recommends": ["ffmpeg", "tesseract", "gstreamer1", "gstreamer1-plugins-good", "pipewire-gstreamer"]
      }
    }
  },
  "plugins": {}
}